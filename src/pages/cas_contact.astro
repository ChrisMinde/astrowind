---
const title = 'H3C CAS & Virtualization Project Inquiry';
const description =
  'Discuss H3C CAS, VMware migration, virtualization and infrastructure requirements with Minde Technologies.';
import logo from "../assets/images/minde-technologies-logo-weiss.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title} | Minde Technologies</title>

    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <!-- =========================
         HEADER
    ========================== -->
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="logo-link">
          <img
            src="/images/minde-technologies-logo-weiss.png"
            alt="Minde Technologies"
            class="logo"
          />
        </a>

        <nav class="main-nav" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/#solutions">Solutions &amp; Services</a>
          <a href="/#why-us">Why Minde</a>
          <a href="/about/">About Us</a>
          <a href="/cas_vsphere_calculator/">CAS Calculator</a>
          <a href="/contact/">Contact</a>
        </nav>
      </div>
    </header>


    <!-- =========================
         HERO
    ========================== -->
    <main>
      <section class="hero">
        <div class="container hero-inner">

          <div class="hero-content">
            <div class="eyebrow">
              H3C CAS &amp; Virtualization
            </div>

            <h1>
              Project Inquiry
            </h1>

            <p>
              Discuss your virtualization, migration and infrastructure
              requirements with our technical team.
            </p>

            <p class="hero-secondary">
              Whether you are evaluating H3C CAS, planning a VMware migration,
              or looking for an enterprise virtualization solution, we are
              ready to discuss your requirements.
            </p>
          </div>

        </div>
      </section>


      <!-- =========================
           MAIN CONTENT
      ========================== -->
      <section class="inquiry-section">
        <div class="container inquiry-grid">

          <!-- =====================
               LEFT COLUMN
          ====================== -->
          <div class="info-column">

            <span class="section-label">
              HOW CAN WE HELP?
            </span>

            <h2>
              Let's discuss your project
            </h2>

            <p class="intro">
              Tell us a little about your requirements and our team will
              contact you to discuss the appropriate solution.
            </p>


            <div class="service-list">

              <div class="service-item">
                <div class="service-icon">
                  CAS
                </div>

                <div>
                  <h3>H3C CAS</h3>

                  <p>
                    Discuss H3C Cloud Automation System, licensing options
                    and deployment requirements.
                  </p>
                </div>
              </div>


              <div class="service-item">
                <div class="service-icon">
                  VM
                </div>

                <div>
                  <h3>VMware Migration</h3>

                  <p>
                    Discuss virtualization migration planning, compatibility
                    and infrastructure requirements.
                  </p>
                </div>
              </div>


              <div class="service-item">
                <div class="service-icon">
                  VS
                </div>

                <div>
                  <h3>Virtualization</h3>

                  <p>
                    Explore virtualization architecture and enterprise
                    infrastructure solutions.
                  </p>
                </div>
              </div>


              <div class="service-item">
                <div class="service-icon">
                  $
                </div>

                <div>
                  <h3>Licensing &amp; Cost</h3>

                  <p>
                    Compare licensing options and discuss potential cost
                    considerations for your environment.
                  </p>
                </div>
              </div>

            </div>


            <!-- Calculator CTA -->
            <div class="calculator-card">

              <span class="calculator-label">
                NEED A QUICK COST COMPARISON?
              </span>

              <h3>
                H3C CAS vs VMware vSphere
              </h3>

              <p>
                Use our license calculator to compare estimated
                virtualization licensing costs.
              </p>

              <a
                href="/cas_vsphere_calculator/"
                class="calculator-link"
              >
                Open License Calculator
                <span aria-hidden="true">→</span>
              </a>

            </div>

          </div>


          <!-- =====================
               RIGHT COLUMN
          ====================== -->
          <div class="form-column">

            <div class="form-card">

              <div class="form-header">
                <span class="section-label">
                  CONTACT OUR TEAM
                </span>

                <h2>
                  Request a Consultation
                </h2>

                <p>
                  Please provide your contact details and tell us about
                  your requirements.
                </p>
              </div>


              <!-- =====================
                   WEB3FORMS
              ====================== -->
              <form
                id="contactForm"
                action="https://api.web3forms.com/submit"
                method="POST"
                novalidate
              >

                <!-- Web3Forms configuration -->
                <input
                  type="hidden"
                  name="access_key"
                  value="4271f0da-01f5-4b42-a31c-e2ac8d58e5f4"
                />

                <input
                  type="hidden"
                  name="subject"
                  value="New H3C CAS / Virtualization Project Inquiry"
                />

                <input
                  type="hidden"
                  name="from_name"
                  value="Minde Technologies Website"
                />

                <!-- Redirect is not used because we handle the response
                     with JavaScript -->
                <input
                  type="hidden"
                  name="redirect"
                  value=""
                />

                <!-- Honeypot -->
                <input
                  type="checkbox"
                  name="botcheck"
                  tabindex="-1"
                  autocomplete="off"
                  class="hidden-field"
                />


                <!-- Company -->
                <div class="form-group">
                  <label for="firma">
                    Company <span>*</span>
                  </label>

                  <input
                    type="text"
                    id="firma"
                    name="firma"
                    autocomplete="organization"
                    required
                  />

                  <small class="error-message"></small>
                </div>


                <!-- Name row -->
                <div class="form-row">

                  <div class="form-group">
                    <label for="name">
                      Last Name <span>*</span>
                    </label>

                    <input
                      type="text"
                      id="name"
                      name="name"
                      autocomplete="family-name"
                      required
                    />

                    <small class="error-message"></small>
                  </div>


                  <div class="form-group">
                    <label for="vorname">
                      First Name
                    </label>

                    <input
                      type="text"
                      id="vorname"
                      name="vorname"
                      autocomplete="given-name"
                    />

                    <small class="error-message"></small>
                  </div>

                </div>


                <!-- Email -->
                <div class="form-group">
                  <label for="email">
                    Email <span>*</span>
                  </label>

                  <input
                    type="email"
                    id="email"
                    name="email"
                    autocomplete="email"
                    required
                  />

                  <small class="error-message"></small>
                </div>


                <!-- Telephone row -->
                <div class="form-row">

                  <div class="form-group">
                    <label for="telefon">
                      Telephone
                    </label>

                    <input
                      type="tel"
                      id="telefon"
                      name="telefon"
                      autocomplete="tel"
                    />
                  </div>


                  <div class="form-group">
                    <label for="mobile">
                      Mobile
                    </label>

                    <input
                      type="tel"
                      id="mobile"
                      name="mobile"
                      autocomplete="tel"
                    />
                  </div>

                </div>


                <!-- Address -->
                <div class="form-group">
                  <label for="adresse">
                    Address
                  </label>

                  <input
                    type="text"
                    id="adresse"
                    name="adresse"
                    autocomplete="street-address"
                  />
                </div>


                <!-- Postal / City -->
                <div class="form-row">

                  <div class="form-group">
                    <label for="plz">
                      Postal Code
                    </label>

                    <input
                      type="text"
                      id="plz"
                      name="plz"
                      autocomplete="postal-code"
                    />
                  </div>


                  <div class="form-group">
                    <label for="ort">
                      City
                    </label>

                    <input
                      type="text"
                      id="ort"
                      name="ort"
                      autocomplete="address-level2"
                    />
                  </div>

                </div>


                <!-- Request Type -->
                <fieldset class="request-types">

                  <legend>
                    How can we help?
                  </legend>

                  <div class="checkbox-grid">

                    <label class="checkbox-item">
                      <input
                        type="checkbox"
                        name="requestType[]"
                        value="H3C CAS"
                      />
                      <span>H3C CAS</span>
                    </label>


                    <label class="checkbox-item">
                      <input
                        type="checkbox"
                        name="requestType[]"
                        value="VMware / vSphere"
                      />
                      <span>VMware / vSphere</span>
                    </label>


                    <label class="checkbox-item">
                      <input
                        type="checkbox"
                        name="requestType[]"
                        value="Migration"
                      />
                      <span>Migration</span>
                    </label>


                    <label class="checkbox-item">
                      <input
                        type="checkbox"
                        name="requestType[]"
                        value="Virtualization"
                      />
                      <span>Virtualization</span>
                    </label>


                    <label class="checkbox-item">
                      <input
                        type="checkbox"
                        name="requestType[]"
                        value="Infrastructure"
                      />
                      <span>Infrastructure</span>
                    </label>


                    <label class="checkbox-item">
                      <input
                        type="checkbox"
                        name="requestType[]"
                        value="Other"
                      />
                      <span>Other</span>
                    </label>

                  </div>

                </fieldset>


                <!-- Message -->
                <div class="form-group">
                  <label for="nachricht">
                    Message
                  </label>

                  <textarea
                    id="nachricht"
                    name="nachricht"
                    rows="6"
                    placeholder="Please briefly describe your requirements..."
                  ></textarea>
                </div>


                <!-- CAPTCHA -->
                <div class="captcha-box">

                  <label for="captchaAnswer">
                    Security check:
                    <strong id="captchaQuestion"></strong>
                  </label>

                  <input
                    type="number"
                    id="captchaAnswer"
                    name="captchaAnswer"
                    inputmode="numeric"
                    required
                  />

                  <input
                    type="hidden"
                    id="captchaExpected"
                  />

                  <small
                    id="captchaError"
                    class="error-message"
                  ></small>

                </div>


                <!-- Buttons -->
                <div class="form-actions">

                  <button
                    type="submit"
                    class="submit-button"
                    id="submitButton"
                  >
                    Send Request
                  </button>

                  <button
                    type="reset"
                    class="reset-button"
                    id="resetButton"
                  >
                    Reset
                  </button>

                </div>


                <!-- Status -->
                <div
                  id="formStatus"
                  class="form-status"
                  role="status"
                  aria-live="polite"
                ></div>

              </form>

            </div>

          </div>

        </div>
      </section>


      <!-- =========================
           BOTTOM CTA
      ========================== -->
      <section class="bottom-cta">

        <div class="container">

          <div class="bottom-cta-inner">

            <div>
              <span class="section-label">
                NOT SURE WHERE TO START?
              </span>

              <h2>
                Compare CAS and VMware licensing costs
              </h2>

              <p>
                Use our calculator to get an estimated licensing cost
                comparison before discussing your project with our team.
              </p>
            </div>


            <a
              href="/cas_vsphere_calculator/"
              class="bottom-cta-button"
            >
              Open CAS Calculator
              <span aria-hidden="true">→</span>
            </a>

          </div>

        </div>

      </section>

    </main>


    <!-- =========================
         FOOTER
    ========================== -->
    <footer class="site-footer">

      <div class="container footer-inner">

        <div>
          <img
            src={logo.src}
            alt="Minde Technologies logo"
            class="footer-logo"
          />
        </div>


        <div class="footer-contact">

          <strong>Minde Technologies GmbH</strong>

          <span>
            Mülistrasse 5, 8320 Fehraltorf, Switzerland
          </span>

          <a href="mailto:info@mindetech.ch">
            info@mindetech.ch
          </a>

          <a href="tel:+41783123805">
            +41 78 312 38 05
          </a>

        </div>


        <div class="footer-links">

          <a href="/contact/">
            General Contact
          </a>

          <a href="/impressum/">
            Impressum
          </a>

          <a href="/privacy/">
            Privacy Policy
          </a>

        </div>

      </div>


      <div class="footer-bottom">

        © {new Date().getFullYear()}
        Minde Technologies GmbH. All rights reserved.

      </div>

    </footer>


    <!-- =========================
         JAVASCRIPT
    ========================== -->
    <script>
      const form = document.getElementById('contactForm');
      const submitButton = document.getElementById('submitButton');
      const resetButton = document.getElementById('resetButton');

      const captchaQuestion =
        document.getElementById('captchaQuestion');

      const captchaExpected =
        document.getElementById('captchaExpected');

      const captchaAnswer =
        document.getElementById('captchaAnswer');

      const captchaError =
        document.getElementById('captchaError');

      const formStatus =
        document.getElementById('formStatus');


      /*
       * Generate CAPTCHA
       */
      function generateCaptcha() {
        const first = Math.floor(Math.random() * 9) + 1;
        const second = Math.floor(Math.random() * 9) + 1;

        captchaQuestion.textContent =
          `${first} + ${second} = ?`;

        captchaExpected.value = String(first + second);

        captchaAnswer.value = '';

        captchaError.textContent = '';
      }


      /*
       * Validate CAPTCHA
       */
      function validateCaptcha() {
        const answer =
          Number(captchaAnswer.value);

        const expected =
          Number(captchaExpected.value);

        if (!captchaAnswer.value) {
          captchaError.textContent =
            'Please complete the security check.';

          return false;
        }

        if (answer !== expected) {
          captchaError.textContent =
            'Incorrect answer. Please try again.';

          return false;
        }

        captchaError.textContent = '';

        return true;
      }


      /*
       * Basic form validation
       */
      function validateForm() {

        let valid = true;

        const requiredFields =
          form.querySelectorAll('[required]');

        requiredFields.forEach((field) => {

          if (
            field.id === 'captchaAnswer'
          ) {
            return;
          }

          if (!field.value.trim()) {

            field.classList.add('input-error');

            valid = false;

          } else {

            field.classList.remove('input-error');

          }

        });


        const email =
          document.getElementById('email');

        if (
          email.value &&
          !email.validity.valid
        ) {

          email.classList.add('input-error');

          valid = false;

        }


        return valid;
      }


      /*
       * Submit form
       */
      form.addEventListener('submit', async (event) => {

        event.preventDefault();

        formStatus.textContent = '';
        formStatus.className = 'form-status';


        if (!validateForm()) {

          formStatus.textContent =
            'Please complete the required fields.';

          formStatus.classList.add('error');

          return;
        }


        if (!validateCaptcha()) {

          formStatus.textContent =
            'Please complete the security check.';

          formStatus.classList.add('error');

          return;
        }


        submitButton.disabled = true;

        submitButton.textContent =
          'Sending...';


        try {

          const formData =
            new FormData(form);

          const response =
            await fetch(
              'https://api.web3forms.com/submit',
              {
                method: 'POST',
                body: formData,
              }
            );


          const result =
            await response.json();


          if (result.success) {

            formStatus.textContent =
              'Thank you. Your request has been sent successfully. We will contact you shortly.';

            formStatus.classList.add('success');

            form.reset();

            generateCaptcha();

          } else {

            throw new Error(
              result.message ||
              'Unable to submit the form.'
            );

          }

        } catch (error) {

          console.error(
            'Web3Forms submission error:',
            error
          );

          formStatus.textContent =
            'Sorry, we could not send your request. Please try again or contact us by email.';

          formStatus.classList.add('error');

        } finally {

          submitButton.disabled = false;

          submitButton.textContent =
            'Send Request';

        }

      });


      /*
       * Reset
       */
      resetButton.addEventListener('click', () => {

        formStatus.textContent = '';

        formStatus.className =
          'form-status';

        document
          .querySelectorAll('.input-error')
          .forEach((element) => {
            element.classList.remove('input-error');
          });

        generateCaptcha();

      });


      /*
       * Generate first CAPTCHA
       */
      generateCaptcha();
    </script>


    <!-- =========================
         CSS
    ========================== -->
    <style>

      * {
        box-sizing: border-box;
      }


      html {
        scroll-behavior: smooth;
      }


      body {
        margin: 0;
        font-family:
          Inter,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          Helvetica,
          Arial,
          sans-serif;

        color: #172033;
        background: #ffffff;
        line-height: 1.6;
      }


      a {
        color: inherit;
      }


      .container {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
      }


      /* =========================
         HEADER
      ========================== */

      .site-header {
        background: #07111f;
        color: #ffffff;
        border-bottom: 1px solid rgba(255,255,255,0.08);
      }


      .header-inner {
        min-height: 76px;
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;

        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
      }


      .logo-link {
        display: flex;
        align-items: center;
      }


      .logo {
        width: 175px;
        height: auto;
        display: block;
      }


      .main-nav {
        display: flex;
        align-items: center;
        gap: 26px;
      }


      .main-nav a {
        color: #ffffff;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        opacity: 0.9;
        transition: opacity 0.2s ease;
      }


      .main-nav a:hover {
        opacity: 1;
      }


      /* =========================
         HERO
      ========================== */

      .hero {
        background: #07111f;
        color: #ffffff;
        padding: 85px 0 90px;
      }


      .hero-inner {
        display: flex;
        justify-content: center;
        text-align: center;
      }


      .hero-content {
        max-width: 850px;
      }


      .eyebrow {
        display: inline-block;

        margin-bottom: 18px;

        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;

        opacity: 0.7;
      }


      .hero h1 {
        margin: 0 0 20px;

        font-size: clamp(42px, 6vw, 64px);
        line-height: 1.08;
        font-weight: 700;
        letter-spacing: -0.03em;
      }


      .hero p {
        margin: 0 auto;

        max-width: 760px;

        font-size: 20px;
        line-height: 1.65;

        opacity: 0.92;
      }


      .hero-secondary {
        margin-top: 18px !important;
        font-size: 16px !important;
        opacity: 0.65 !important;
      }


      /* =========================
         INQUIRY SECTION
      ========================== */

      .inquiry-section {
        padding: 90px 0;
        background: #f6f8fb;
      }


      .inquiry-grid {
        display: grid;
        grid-template-columns:
          minmax(0, 0.9fr)
          minmax(0, 1.1fr);

        gap: 70px;

        align-items: start;
      }


      .section-label {
        display: block;

        margin-bottom: 12px;

        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.13em;

        color: #52657d;
      }


      .info-column h2,
      .form-header h2 {
        margin: 0 0 18px;

        font-size: 34px;
        line-height: 1.2;
        letter-spacing: -0.02em;
      }


      .intro {
        margin: 0 0 35px;

        color: #5c6878;
        font-size: 16px;
      }


      /* =========================
         SERVICES
      ========================== */

      .service-list {
        display: flex;
        flex-direction: column;
        gap: 25px;
      }


      .service-item {
        display: grid;

        grid-template-columns: 48px 1fr;

        gap: 16px;
      }


      .service-icon {
        width: 48px;
        height: 48px;

        border-radius: 10px;

        background: #e8edf5;

        display: flex;
        align-items: center;
        justify-content: center;

        color: #182c48;

        font-size: 12px;
        font-weight: 800;
      }


      .service-item h3 {
        margin: 0 0 5px;

        font-size: 17px;
      }


      .service-item p {
        margin: 0;

        color: #687587;

        font-size: 14px;
        line-height: 1.65;
      }


      /* =========================
         CALCULATOR CARD
      ========================== */

      .calculator-card {
        margin-top: 45px;

        padding: 28px;

        background: #ffffff;

        border: 1px solid #e1e6ed;

        border-radius: 14px;
      }


      .calculator-label {
        display: block;

        margin-bottom: 8px;

        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;

        color: #6c7888;
      }


      .calculator-card h3 {
        margin: 0 0 8px;

        font-size: 20px;
      }


      .calculator-card p {
        margin: 0 0 18px;

        color: #697688;
        font-size: 14px;
      }


      .calculator-link {
        color: #172f50;

        text-decoration: none;

        font-size: 14px;
        font-weight: 700;
      }


      .calculator-link:hover {
        text-decoration: underline;
      }


      /* =========================
         FORM CARD
      ========================== */

      .form-card {
        padding: 42px;

        background: #ffffff;

        border: 1px solid #e1e6ed;

        border-radius: 16px;

        box-shadow:
          0 15px 45px rgba(17, 31, 52, 0.07);
      }


      .form-header {
        margin-bottom: 30px;
      }


      .form-header p {
        margin: 0;

        color: #687587;
        font-size: 15px;
      }


      /* =========================
         FORM
      ========================== */

      .form-group {
        margin-bottom: 20px;
      }


      .form-row {
        display: grid;

        grid-template-columns:
          repeat(2, minmax(0, 1fr));

        gap: 16px;
      }


      label,
      legend {
        display: block;

        margin-bottom: 7px;

        color: #27364a;

        font-size: 13px;
        font-weight: 600;
      }


      label span {
        color: #a14b4b;
      }


      input,
      textarea {
        width: 100%;

        border: 1px solid #ccd4df;

        border-radius: 7px;

        background: #ffffff;

        color: #172033;

        padding: 12px 13px;

        font-family: inherit;
        font-size: 14px;

        outline: none;

        transition:
          border-color 0.2s ease,
          box-shadow 0.2s ease;
      }


      input:focus,
      textarea:focus {
        border-color: #607895;

        box-shadow:
          0 0 0 3px rgba(96, 120, 149, 0.12);
      }


      textarea {
        resize: vertical;
        min-height: 130px;
      }


      .input-error {
        border-color: #b45c5c !important;
      }


      .error-message {
        display: block;

        min-height: 18px;

        margin-top: 5px;

        color: #a14b4b;

        font-size: 12px;
      }


      /* =========================
         REQUEST TYPES
      ========================== */

      .request-types {
        margin: 5px 0 22px;

        padding: 0;

        border: 0;
      }


      .request-types legend {
        margin-bottom: 12px;
      }


      .checkbox-grid {
        display: grid;

        grid-template-columns:
          repeat(2, minmax(0, 1fr));

        gap: 10px;
      }


      .checkbox-item {
        display: flex;

        align-items: center;

        gap: 9px;

        margin: 0;

        padding: 10px 12px;

        border: 1px solid #e0e5ec;

